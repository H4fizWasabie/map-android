      "css": ".ds-secondary { background:#FFFFFF;color:#201D28;border:1px solid #DED8E6;border-radius:16px;min-height:48px;padding:8px 16px;font:400 14px \"Work Sans\",sans-serif;cursor:pointer } .ds-secondary:hover,.ds-secondary:active { background:#E9DDF5 } .ds-secondary:focus-visible { outline:2px solid #7651A6;outline-offset:3px } .ds-secondary:disabled { color:#696271;cursor:default }"
    },
