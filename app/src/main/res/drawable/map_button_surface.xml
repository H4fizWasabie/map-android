<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/map_divider" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/map_focus" />
            <stroke android:width="1dp" android:color="@color/map_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/map_card" />
            <stroke android:width="1dp" android:color="@color/map_divider" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
