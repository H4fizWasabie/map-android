<resources>
    <style name="MapButton" parent="@android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/map_button_surface</item>
        <item name="android:textColor">@color/map_text</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="MapPrimaryButton" parent="MapButton">
        <item name="android:background">@drawable/map_button_primary</item>
        <item name="android:textColor">@color/map_on_accent</item>
    </style>

    <style name="MapNavigationButton" parent="MapButton">
        <item name="android:background">@drawable/map_nav_button</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="Theme.MAP" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonStyle">@style/MapButton</item>
        <item name="android:colorButtonNormal">@color/map_card</item>
        <item name="android:colorAccent">@color/map_accent</item>
        <item name="android:windowBackground">@color/map_background</item>
        <item name="android:navigationBarColor">@color/map_background</item>
        <item name="android:statusBarColor">@color/map_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
