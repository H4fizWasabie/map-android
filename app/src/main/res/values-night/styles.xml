<resources>
    <style name="Theme.MAP" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <item name="android:fontFamily">@font/work_sans</item>
        <item name="android:textColorPrimary">@color/map_text</item>
        <item name="android:textColorSecondary">@color/map_muted</item>
        <item name="android:colorControlNormal">@color/map_muted</item>
        <item name="android:colorControlActivated">@color/map_accent</item>
        <item name="colorPrimary">@color/map_accent</item>
        <item name="colorOnPrimary">@color/map_on_accent</item>
        <item name="colorPrimaryContainer">@color/map_focus</item>
        <item name="colorOnPrimaryContainer">@color/map_text</item>
        <item name="colorSecondary">@color/map_muted</item>
        <item name="colorOnSecondary">@color/map_background</item>
        <item name="colorSecondaryContainer">@color/map_selection</item>
        <item name="colorOnSecondaryContainer">@color/map_accent_pressed</item>
        <item name="colorTertiary">@color/map_status</item>
        <item name="colorOnTertiary">@color/map_background</item>
        <item name="colorTertiaryContainer">@color/map_focus</item>
        <item name="colorOnTertiaryContainer">@color/map_text</item>
        <item name="android:colorBackground">@color/map_background</item>
        <item name="colorOnBackground">@color/map_text</item>
        <item name="colorSurface">@color/map_background</item>
        <item name="colorOnSurface">@color/map_text</item>
        <item name="colorSurfaceVariant">@color/map_card</item>
        <item name="colorOnSurfaceVariant">@color/map_muted</item>
        <item name="colorSurfaceContainer">@color/map_nav_background</item>
        <item name="colorSurfaceContainerLow">@color/map_card</item>
        <item name="colorSurfaceContainerHigh">@color/map_focus</item>
        <item name="colorSurfaceContainerHighest">@color/map_nav_background</item>
        <item name="colorOutline">@color/map_divider</item>
        <item name="colorOutlineVariant">@color/map_divider</item>
        <item name="colorError">@color/map_error</item>
        <item name="colorOnError">@color/map_on_error</item>
        <item name="colorErrorContainer">@color/map_error_container</item>
        <item name="colorOnErrorContainer">@color/map_on_error_container</item>
        <item name="bottomNavigationStyle">@style/Widget.MAP.NavigationBar</item>
        <item name="navigationRailStyle">@style/Widget.MAP.NavigationRail</item>
        <item name="android:windowBackground">@color/map_background</item>
        <item name="android:navigationBarColor">@color/map_background</item>
        <item name="android:statusBarColor">@color/map_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.MAP.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/Theme.MAP.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/Theme.MAP.Dialog</item>
    </style>

    <style name="Theme.MAP.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">@font/work_sans</item>
        <item name="android:textColorPrimary">@color/map_text</item>
        <item name="android:textColorSecondary">@color/map_muted</item>
        <item name="android:colorControlNormal">@color/map_muted</item>
        <item name="android:colorControlActivated">@color/map_accent</item>
        <item name="android:colorAccent">@color/map_accent</item>
        <item name="android:background">@color/map_card</item>
        <item name="android:windowBackground">@color/map_card</item>
    </style>
</resources>
